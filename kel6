                                    <span>Enabled Two-Factor Authentication (2FA)</span>
                                </label>
                                <label class="flex items-center space-x-2 bg-theme-card p-2.5 rounded-lg border border-theme-border/60 cursor-pointer hover:border-theme-cyan">
                                    <input type="checkbox" onchange="calculatePrivacyScore()" class="privacy-chk rounded text-theme-cyan focus:ring-0">
                                    <span>Set social media profiles to Private mode</span>
                                </label>
                                <label class="flex items-center space-x-2 bg-theme-card p-2.5 rounded-lg border border-theme-border/60 cursor-pointer hover:border-theme-cyan">
                                    <input type="checkbox" onchange="calculatePrivacyScore()" class="privacy-chk rounded text-theme-cyan focus:ring-0">
                                    <span>Avoid sharing phone numbers & live location</span>
