    <!-- JAVASCRIPT CONTROLLERS -->
    <script>
        let currentPage = 1;
        const totalPages = 7;

        function updatePagination() {
            document.getElementById('current-page-num').innerText = currentPage;
            document.getElementById('prev-btn').disabled = currentPage === 1;
            document.getElementById('next-btn').disabled = currentPage === totalPages;
            
            document.getElementById('prev-btn').style.opacity = currentPage === 1 ? '0.5' : '1';
            document.getElementById('next-btn').style.opacity = currentPage === totalPages ? '0.5' : '1';

            // Hide all pages
            for (let i = 1; i <= totalPages; i++) {
                const p = document.getElementById(`page-${i}`);
                if (p) p.classList.add('hidden');
            }

            // Show active page
            const activePage = document.getElementById(`page-${currentPage}`);
            if (activePage) activePage.classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function navigateTo(pageId) {
            const pageNum = parseInt(pageId.replace('page-', ''));
            if (pageNum >= 1 && pageNum <= totalPages) {
                currentPage = pageNum;
                updatePagination();
            }
        }

        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                updatePagination();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                updatePagination();
            }
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Accordion Controller
        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById(`${id}-icon`);
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // Post Risk Simulator Logic
        function analyzeSimPost() {
            const val = document.getElementById('sim-post-input').value.trim().toLowerCase();
            const resultBox = document.getElementById('sim-post-result');
            resultBox.classList.remove('hidden');

            if (!val) {
                resultBox.className = "p-3 rounded-xl text-xs bg-cyan-950/60 border border-cyan-500/50 text-cyan-200";
                resultBox.innerHTML = "<i class='fa-solid fa-circle-info mr-1'></i> Please enter a sample post to evaluate risk level.";
                return;
            }

            const riskyKeywords = ['hate', 'angry', 'stolen', 'password', 'address', 'stupid', 'ugly', 'secret', 'phone number', 'cheat'];
            const foundRisks = riskyKeywords.filter(k => val.includes(k));

            if (foundRisks.length > 0) {
                resultBox.className = "p-3 rounded-xl text-xs bg-red-950/80 border border-red-500/60 text-red-200";
                resultBox.innerHTML = `<strong><i class='fa-solid fa-triangle-exclamation mr-1'></i> High Digital Footprint Risk Detected!</strong><br>This draft contains sensitive or emotional triggers ("${foundRisks.join(', ')}"). Screenshots could permanently affect your future university applications or employment background checks.`;
            } else {
                resultBox.className = "p-3 rounded-xl text-xs bg-cyan-900/60 border border-cyan-400/60 text-cyan-200";
                resultBox.innerHTML = `<strong><i class='fa-solid fa-circle-check mr-1'></i> Post Looks Safe!</strong><br>No obvious personal data or high-risk keywords detected. Always remember: ensure your tone remains respectful and considerate to everyone.`;
            }
        }

        // Timeline Step Logic
        function showTimelineStep(step) {
            const detail = document.getElementById('timeline-detail');
            if (step === 1) {
                detail.innerText = "Immediate Post (Day 1): You post a spontaneous emotional rant or private detail online. It seems temporary or minor to you.";
            } else if (step === 2) {
                detail.innerText = "6 Months Later: Someone takes a screenshot or stores the post in a public web archive, even if you delete the original post.";
            } else if (step === 3) {
                detail.innerText = "3 Years Later: College admission panels or potential employers conduct background checks and discover the archived content.";
            }
        }

        // Privacy Score Calculator Logic
        function calculatePrivacyScore() {
            const checkboxes = document.querySelectorAll('.privacy-chk');
            let checkedCount = 0;
            checkboxes.forEach(chk => { if (chk.checked) checkedCount++; });
            
            const percent = Math.round((checkedCount / checkboxes.length) * 100);
            document.getElementById('privacy-score-val').innerText = `${percent}%`;
            document.getElementById('privacy-score-bar').style.width = `${percent}%`;

            const desc = document.getElementById('privacy-score-desc');
            if (percent === 100) {
                desc.innerText = "Excellent! Your digital privacy and security settings are optimal.";
                desc.className = "text-[11px] text-cyan-400 font-semibold text-center";
            } else if (percent >= 60) {
                desc.innerText = "Good progress! Consider strengthening the remaining security steps.";
                desc.className = "text-[11px] text-cyan-300 font-semibold text-center";
            } else {
                desc.innerText = "Warning! Your online account may be vulnerable to data leaks or identity risks.";
                desc.className = "text-[11px] text-red-400 font-semibold text-center";
            }
        }

        // Etiquette Tab Switching
        function switchEtiquetteTab(tab) {
            const dosBtn = document.getElementById('tab-dos-btn');
            const dontsBtn = document.getElementById('tab-donts-btn');
            const dosContent = document.getElementById('tab-dos-content');
            const dontsContent = document.getElementById('tab-donts-content');

            if (tab === 'dos') {
                dosBtn.className = "flex-1 py-2 text-center border-b-2 border-theme-cyan text-theme-cyan font-semibold";
                dontsBtn.className = "flex-1 py-2 text-center text-theme-muted hover:text-white";
                dosContent.classList.remove('hidden');
                dontsContent.classList.add('hidden');
            } else {
                dontsBtn.className = "flex-1 py-2 text-center border-b-2 border-theme-cyan text-theme-cyan font-semibold";
                dosBtn.className = "flex-1 py-2 text-center text-theme-muted hover:text-white";
                dontsContent.classList.remove('hidden');
                dosContent.classList.add('hidden');
            }
        }

        // Recommendation Filtering Logic
        function filterRec(type) {
            const cards = document.querySelectorAll('.rec-card');
            const btns = ['all', 'student', 'teacher', 'school'];

            btns.forEach(b => {
                const btnEl = document.getElementById(`rec-btn-${b}`);
                if (b === type) {
                    btnEl.className = "px-4 py-2 rounded-xl text-xs font-bold cyan-bg-gradient text-theme-dark transition";
                } else {
                    btnEl.className = "px-4 py-2 rounded-xl text-xs font-bold bg-theme-card text-white border border-theme-border hover:border-theme-cyan transition";
                }
            });

            cards.forEach(card => {
                if (type === 'all' || card.classList.contains(`rec-${type}`)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Initialize Page Navigation
        window.onload = function() {
            updatePagination();
        };
    </script>
